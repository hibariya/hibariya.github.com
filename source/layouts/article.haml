!!! 5
%html
  %head
    %title= "#{current_page.data.title || config.title} - #{config.site_name}"
    %meta(charset='utf-8')
    %meta(name='author'){content: config.author}
    %link(rel='icon' type='image/png' href='/favicon.png')
    %link(rel='alternate' title='Atom' type='application/atom+xml' href='/articles.xml')

    = stylesheet_link_tag 'application', media: 'all'
    = javascript_include_tag 'application'

    %link(rel='canonical'){href: URI.join(config.base_url, current_article.url)}

  %body{class: page_classes}
    %header
      %h1
        = link_to config.site_name, '/'
      %nav
        %ul#menu
          %li= link_to 'Home',     '/'
          %li= link_to 'Articles', '/articles.html'
          %li= link_to 'Github', 'https://github.com/hibariya', target: '_blank'
          %li= link_to 'X (Twitter)', 'https://x.com/hibariya', target: '_blank'
          %li= link_to 'hibariya.org', 'https://hibariya.org', target: '_blank'

    %main
      %article
        %time= current_article.date.to_date
        %h1= link_to current_article.title, current_article

        = yield

      #comments
        <div id="disqus_thread"></div>
        :javascript
          /* * * CONFIGURATION VARIABLES * * */
          var disqus_shortname = '#{config.disqus_shortname}';

          /* * * DON'T EDIT BELOW THIS LINE * * */
          (function() {
            var dsq = document.createElement('script'); dsq.type = 'text/javascript'; dsq.async = true;
            dsq.src = '//' + disqus_shortname + '.disqus.com/embed.js';
            (document.getElementsByTagName('head')[0] || document.getElementsByTagName('body')[0]).appendChild(dsq);
          })();

:javascript
  (function(i,s,o,g,r,a,m){i['GoogleAnalyticsObject']=r;i[r]=i[r]||function(){
  (i[r].q=i[r].q||[]).push(arguments)},i[r].l=1*new Date();a=s.createElement(o),
  m=s.getElementsByTagName(o)[0];a.async=1;a.src=g;m.parentNode.insertBefore(a,m)
  })(window,document,'script','//www.google-analytics.com/analytics.js','ga');

  ga('create', 'UA-64572851-1', 'auto');
  ga('send', 'pageview');

